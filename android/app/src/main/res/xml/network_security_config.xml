<?xml version="1.0" encoding="utf-8"?>
<!--
  The pic-sync server runs on the user's Mac and speaks plain HTTP on a LAN IP
  (e.g. http://192.168.1.23:8080). <domain-config> can't match arbitrary IP
  addresses, so cleartext has to be allowed in the base config. The app only
  ever talks to the server URL the user scanned or typed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
